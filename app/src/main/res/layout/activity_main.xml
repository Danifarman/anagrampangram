<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Anagram Input 1 -->
    <EditText
        android:id="@+id/etAnagram1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edittext_normal"
        android:hint="Enter first word" />

    <!-- Anagram Input 2 -->
    <EditText
        android:id="@+id/etAnagram2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter second word"
        android:background="@drawable/edittext_normal"
        android:layout_marginTop="8dp" />

    <!-- Anagram Button -->

    <!-- Anagram Result -->
    <Button
        android:id="@+id/btnAnagram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Check Anagram" />

    <TextView
        android:id="@+id/tvAnagramResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Result will appear here"
        android:layout_marginTop="8dp" />

    <!-- Pangram Input -->
    <EditText
        android:id="@+id/etPangram"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter sentence for pangram check"
        android:layout_marginTop="16dp" />

    <!-- Pangram Button -->
    <Button
        android:id="@+id/btnPangram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check Pangram"
        android:layout_marginTop="8dp" />

    <!-- Pangram Result -->
    <TextView
        android:id="@+id/tvPangramResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Result will appear here"
        android:layout_marginTop="8dp" />

</LinearLayout>
